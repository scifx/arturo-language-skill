# Copy to config.env and edit only when command auto-detection is insufficient.
# Values are consumed by bin/ahelp and scripts/get-arturo.sh. Keep this file as trusted shell syntax.

# The bundled runtime in this repo is the preferred one: bin/arturo (Full,
# no UI) or bin/arturo-mini (Mini). Point ARTURO_BIN at it (ahelp auto-detects
# bin/arturo from the repo too).
ARTURO_BIN=arturo
AHELP_LIMIT=20
# PYTHON_BIN=python3   # hint for the optional Python helper scripts/arturo_help.py;
#                      # bin/ahelp does not use Python.

# SHA-256 pins for the bundled binaries (see references/runtime-dependencies.md).
# Only used by scripts/get-arturo.sh's fallback download path (scifx/arturo-bin).
#BUNDLED_ARTURO_SHA256=b7597e9d5ea3d0c0229e37c936518b12c0d69cb9ffe514fad63a9e08f2b0a38d
#BUNDLED_MINI_SHA256=78fbbf467528a8b7e2cc83d5015f5d75c3c6165f7f188ef543b7bcae848705ad
#ARTURO_SHA256=73bda27194bf0ae0dcc89550cfd590313f6e1c586f0f255e01e0b2b82388d3cb
