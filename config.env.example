# Copy to config.env and edit only when command auto-detection is insufficient.
# Values are consumed by bin/ahelp and scripts/get-arturo.sh. Keep this file as trusted shell syntax.

ARTURO_BIN=arturo
PYTHON_BIN=python3
AHELP_LIMIT=20

# Expected SHA-256 of the binary fetched from scifx/arturo-bin (see
# references/runtime-dependencies.md). Update when the maintainer uploads a new
# binary (e.g. the Mini/no-UI build); get-arturo.sh prints the new hash on mismatch.
#ARTURO_SHA256=73bda27194bf0ae0dcc89550cfd590313f6e1c586f0f255e01e0b2b82388d3cb
